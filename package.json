{
	"$schema": "https://schemastore.org/package",
	"author": "qwertycxz",
	"bin": {
		"acp-to-ws": "dist/index.js"
	},
	"bugs": "https://github.com/qwertycxz/acp-to-ws/issues",
	"dependencies": {
		"@agentclientprotocol/sdk": "^1.4.0",
		"ws": "^8.21.0"
	},
	"description": "Redirect ACP to WebSocket",
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@types/node": "^26.6.0",
		"@types/ws": "^8.18.0",
		"prettier": "^3.9.0",
		"typescript": "^7.0.0"
	},
	"directories": {
		"man": "man"
	},
	"files": [
		"dist",
		"man"
	],
	"funding": "https://ko-fi.com/qwertycxz",
	"keywords": [
		"acp",
		"websocket",
		"ws"
	],
	"license": "Apache-2.0",
	"name": "acp-to-ws",
	"prettier": {
		"arrowParens": "avoid",
		"jsxSingleQuote": true,
		"overrides": [
			{
				"files": "*.yml",
				"options": {
					"tabWidth": 2
				}
			}
		],
		"printWidth": 256,
		"proseWrap": "never",
		"quoteProps": "consistent",
		"semi": false,
		"singleQuote": true,
		"tabWidth": 4,
		"useTabs": true
	},
	"repository": "https://github.com/qwertycxz/acp-to-ws",
	"scripts": {
		"build": "tsc",
		"clean": "tsc -b --clean",
		"dev": "node --watch src/index.ts",
		"format": "prettier -w .",
		"format:check": "prettier -c .",
		"lint": "biome check",
		"lint:fix": "biome check --fix --unsafe",
		"man": "mkdir man && pandoc README.md -o man/pm2-logs-attach-input.1",
		"start": "node dist/index.js"
	},
	"type": "module",
	"version": "0.0.0"
}
